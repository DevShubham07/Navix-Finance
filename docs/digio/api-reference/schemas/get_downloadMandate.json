          "description": "file",
          "value": "Zip File"
         }
        },
        "schema": {
         "description": "Zip File",
         "format": "byte",
         "type": "file"
        }
       }
      },
      "description": "Successfully downloaded the document"
     },
     "400": {
      "content": {
       "application/json": {
        "examples": {
         "Bad Request": {
          "description": "Bad Request",
          "value": {
           "code": "ENTITY_NOT_FOUND",
           "details": "EX23297402937402",
           "message": "Entity not found for this id"
          }
         }
        },
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse"
        }
       }
      }
     }
    },
    "security": [
     {
      "api_auth": []
     }
    ],
    "summary": "Download Mandate Files (XML and processed images) [Physical NACH]"
