 "paths": {
  "/v3/client/upi_payment/scheduled/register_multiple": {
   "post": {
    "description": "This API is used to create schedule plan for a multiple UMRN. Max number of presentations which can be created is 500 per api call.",
    "operationId": "createUpiScheduledPlanMulti",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/UpiScheduledPlanCreateMultiRequest_Client"
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "examples": {
         "Success Response": {
          "description": "Success Response",
          "value": "[\n    \"NSP1907171443025142M75F7G2JH8THE\",\n    <entry-2 digio generated unique id>,\n    <entry-3 digio generated unique id>\n]\n"
         }
        },
        "schema": {
         "$ref": "#/components/schemas/GenericIdListResponse_Client"
        }
       }
      }
     },
     "400": {
      "content": {
       "application/json": {
        "examples": {
         "Bad Request": {
          "description": "Bad Request",
          "value": {
           "code": "BAD_REQUEST",
           "details": "EX230000000",
           "errors": {
            "15": "Request modification is not allowed. Please check value for customer_account_number",
            "50": "amount or amount_in_paise cannot be null. ",
            "6": "Action not allowed in current mandate state"
           },
           "message": "Action not allowed in current mandate state"
          }
         }
        },
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse_Client"
        }
       }
      }
     }
    },
    "security": [
     {
      "api_auth": []
     }
    ],
    "summary": "Create presentation for a multiple UMRNs"
   }
  }
