   "UpiScheduledPlanCreateMultiRequest_Client": {
    "example": "{\n  \"requests\": [\n    {\n      \"umrn\": \"10b3ab554e0e40bfbff7843d4743fe63@upi\",\n      \"amount\": 9.0,\n      \"settlement_date\": \"2019-04-10 14:30:00\",\n      \"corporate_account_number\": \"123456789\",\n      \"unique_key\": \"LAN_EMI_1\",\n      \"narration\": \"TW Loan EMI\"\n    },\n    {\n      <entry-2>\n    },\n    {\n      <entry-3>\n    }\n  ]\n}",
