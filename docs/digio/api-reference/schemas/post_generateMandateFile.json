          }
         }
        },
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse"
        }
       }
      }
     }
    },
    "security": [
     {
      "api_auth": []
     }
    ],
    "summary": "Download NACH physical form [Physical NACH]"
   }
