    "parameters": [
     {
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/octet-stream": {
        "schema": {
         "description": "A binary stream of the filled NACH PDF form.",
         "format": "binary",
         "type": "string"
        }
       }
      },
      "description": "Returns the filled NACH PDF form as a binary stream."
     },
     "400": {
