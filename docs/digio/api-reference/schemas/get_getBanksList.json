 "openapi": "3.0.1",
 "paths": {
  "/v3/client/mandate/banks": {
   "get": {
    "description": "This API retrieves a list of banks that are live in the system. The banks returned can be filtered based on the mode and whether they support penny-less transactions.",
    "operationId": "getBanksList",
    "parameters": [
     {
      "description": "Filter by mode of operation. Allowed values: API, ESIGN, PHYSICAL.",
      "example": "API",
      "in": "query",
      "name": "mode",
      "schema": {
       "type": "string"
      }
     },
     {
      "description": "Filter by penny-less support. If true, only banks supporting penny-less transactions are returned.",
      "example": true,
      "in": "query",
      "name": "penny_less",
      "schema": {
       "type": "boolean"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "examples": {
         "Success": {
          "description": "Success",
          "value": [
           {
            "active": true,
            "api_mandate": false,
            "esign_mandate": false,
            "id": "BNI190205133107279IW29M2B4TZ7PAJ",
            "ifsc_prefix": "ICIC",
            "name": "510 Army Base W/s Credit Coop Primary Bank Ltd.",
            "penny_less": false,
            "physical_mandate": true,
            "primary_bank": false,
            "routing_code": "ARMX"
           },
           {
            "active": true,
            "api_mandate": false,
            "esign_mandate": false,
            "id": "BNI190205153036123F6UIBWCVOFSTSK",
