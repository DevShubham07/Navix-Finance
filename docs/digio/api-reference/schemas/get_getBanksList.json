            "name": "Abhinandan Urban Coop Bank Amravati",
            "penny_less": true,
            "physical_mandate": true,
            "primary_bank": false,
            "routing_code": "ABUX"
           },
           {
            "active": true,
            "api_mandate": false,
            "esign_mandate": true,
            "id": "BNI1812040345269602CUEACAFX9R7JC",
            "ifsc_prefix": "ABHY",
            "name": "Abhyudaya Co Op Bank",
            "penny_less": true,
            "physical_mandate": true,
            "primary_bank": false,
            "routing_code": "ABHY"
           },
           {
            "active": true,
            "api_mandate": false,
            "esign_mandate": false,
            "id": "BNI1902051331072707IKYF5BTXXG3YP",
