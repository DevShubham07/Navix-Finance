            "status": "payment_success"
           },
           "id": "NPT1904111122223333BCBDQIQ4HAB",
           "state": "success",
           "status_updated_at": "2019-04-15 16:26:08",
           "umrn": "UMRN4444333322221111",
           "updated_at": "2019-04-15 16:26:08"
          }
         }
        },
        "schema": {
         "$ref": "#/components/schemas/ExternalNachDebitTxnOnGetSchema_Client"
        }
       }
      }
     },
     "400": {
      "content": {
