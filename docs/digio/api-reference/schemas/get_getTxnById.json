          }
         }
        },
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse_Client"
        }
       }
      }
     }
    },
    "security": [
     {
      "api_auth": []
     }
    ],
    "summary": "Get Transaction Details"
   }
  }
 },
