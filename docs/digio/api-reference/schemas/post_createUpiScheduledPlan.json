     },
     "customerName": {
      "type": "string"
     },
     "customerRefNumber": {
      "type": "string"
     },
     "customerVpa": {
      "type": "string"
     },
     "destinationBankIfsc": {
      "type": "string"
     },
     "digioEnachId": {
      "type": "string"
     },
     "frequency": {
      "enum": [
       "ADHO",
       "INDA",
       "DAIL",
       "WEEK",
       "MNTH",
       "QURT",
       "MIAN",
       "YEAR",
       "ONETIME",
       "BIMN"
      ],
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "identifier": {
      "type": "string"
     },
     "mandateEndDate": {
      "format": "date-time",
      "type": "string"
     },
     "mandateRequestId": {
      "type": "string"
     },
     "mandateStartDate": {
      "format": "date-time",
      "type": "string"
     },
     "merchantCategoryCode": {
      "type": "string"
     },
     "narration": {
      "type": "string"
     },
     "ownerId": {
      "type": "string"
     },
     "partnerBank": {
      "enum": [
       "KOTAK",
       "YESB",
       "JUSPAY_KOTAK",
       "MGS_YESB"
      ],
