{
 "components": {
  "schemas": {
   "CorporateDetailsSchema_Client": {
    "description": "Details of corporate",
    "properties": {
     "corporate_account_number": {
      "description": "Masked account number of the corporate",
      "type": "string"
     },
     "corporate_reference": {
      "description": "Reference number against the corporate",
      "type": "string"
     },
     "name": {
      "description": "Name of the corporate",
      "type": "string"
     },
     "sponsor_bank_code": {
      "description": "Bank code for sponsor bank",
      "type": "string"
     },
     "sponsor_ifsc": {
      "description": "IFSC code of the sponsor bank",
      "type": "string"
     },
     "utility_code": {
      "description": "Utility code registered for the corporate",
      "type": "string"
     }
    },
    "type": "object"
   },
   "CustomerDetailsSchema_Client": {
    "description": "Details of customer",
    "properties": {
     "destination_account_type": {
      "default": "SAVINGS",
      "description": "Type of account of the customer",
      "enum": [
       "SAVINGS",
       "CURRENT",
       "OTHER"
      ],
      "type": "string"
     },
     "destination_ifsc": {
      "description": "IFSC code of the bank",
      "type": "string"
     },
     "name": {
      "description": "Name of the customer",
      "type": "string"
     },
     "user_account_number": {
      "description": "Masked account number of the customer",
      "type": "string"
     }
    },
    "type": "object"
   },
   "CustomerDetails_Client": {
    "properties": {
     "identifier": {
      "description": "Unique ID of the customer",
      "type": "string"
     },
     "name": {
      "description": "Name of the customer",
      "type": "string"
     }
    },
    "type": "object"
   },
   "ExternalPaymentInflowSettlement_Client": {
    "properties": {
     "account_number": {
      "description": "Account number associated with the settlement",
      "type": "string"
     },
     "consolidation_id": {
      "description": "Consolidation identifier for the settlement",
      "type": "string"
     },
     "fee1": {
      "description": "First fee amount deducted from the settlement",
      "type": "number"
     },
     "fee2": {
      "description": "Second fee amount deducted from the settlement",
      "type": "number"
     },
     "final_amount": {
      "description": "Final amount after taxes and fees have been deducted",
      "type": "number"
     },
     "settlement_bank_account_name": {
      "description": "Name of the settlement bank account",
      "type": "string"
     },
     "settlement_bank_txn_ref": {
      "description": "Bank transaction reference for the settlement",
      "type": "string"
     },
     "status": {
      "description": "Status of the external settlement",
      "enum": [
       "scheduled",
       "settle_success"
      ],
      "type": "string"
     },
     "tax1": {
      "description": "First tax amount deducted from the settlement",
      "type": "number"
     },
     "tax2": {
      "description": "Second tax amount deducted from the settlement",
      "type": "number"
     },
     "tax3": {
      "description": "Third tax amount deducted from the settlement",
      "type": "number"
     },
     "total_amount": {
      "description": "Total amount to be settled",
      "type": "number"
     }
    },
    "type": "object"
   },
   "ExternalSubUser_Client": {
    "description": "Only present if a sub-user has created the schedule.",
    "properties": {
     "email_id": {
      "description": "Sub-user's email id, if registered",
      "type": "string"
     },
     "id": {
      "description": "Unique ID for sub-user",
      "type": "string"
     },
     "identifier": {
      "description": "This denotes what type of identifier was used",
      "enum": [
       "email",
       "mobile",
       "unknown"
      ],
      "type": "string"
     },
     "identifier_value": {
      "description": "Identifier for sub-user, this is generally emailID or mobile number",
      "type": "string"
     },
     "mobile": {
      "description": "Subuser's mobile number",
      "type": "string"
     }
    },
    "type": "object"
   },
   "ExternalUpiDebitTxnSchema_Client": {
    "description": "List of all transactions for the specific UPI schedule plan",
    "properties": {
     "created_at": {
      "description": "Creation timestamp of the transaction",
      "format": "date-time",
      "type": "string"
     },
     "customer": {
      "$ref": "#/components/schemas/CustomerDetails_Client"
     },
     "details": {
      "$ref": "#/components/schemas/UpiTxnDetailsSchema_Client"
     },
     "digio_utr": {
      "description": "Digio's unique transaction reference number",
      "type": "string"
     },
     "id": {
      "description": "Unique identifier for the transaction",
      "type": "string"
     },
     "parent_transaction_id": {
      "description": "Identifier of the parent transaction, if any",
      "type": "string"
     },
     "settlement_date": {
      "description": "Date of settlement for the transaction",
      "format": "date-time",
      "type": "string"
     },
     "settlement_details": {
      "$ref": "#/components/schemas/ExternalPaymentInflowSettlement_Client"
     },
     "settlement_transaction_details": {
      "description": "List of details for each settlement transaction",
      "items": {
       "$ref": "#/components/schemas/TransactionDetails_Client"
      },
      "type": "array"
     },
     "state": {
      "description": "State of the transaction",
      "enum": [
       "scheduled",
       "skipped",
       "notified",
       "processing",
       "delayed",
       "failed",
       "authenticated",
       "success"
      ],
      "type": "string"
     },
     "status_updated_at": {
      "description": "Timestamp when the transaction status was last updated",
      "format": "date-time",
      "type": "string"
     },
     "umrn": {
      "description": "UMRN associated with the transaction",
      "type": "string"
     },
     "updated_at": {
      "description": "Update timestamp of the transaction",
      "format": "date-time",
      "type": "string"
     }
    },
    "type": "object"
   },
   "ExternalUpiMandateSchema_Client": {
    "description": "Mandate information associated with the scheduled plan",
    "properties": {
     "auth_type": {
      "description": "Authentication type for the mandate",
      "enum": [
       "UPI"
      ],
      "type": "string"
     },
     "authentication_time": {
      "description": "Timestamp when the mandate was authenticated",
      "format": "date-time",
      "type": "string"
     },
     "collection_amount": {
      "description": "Amount to be collected per transaction",
      "type": "number"
     },
     "corporate_config_id": {
      "description": "Configuration ID for the corporate",
      "type": "string"
     },
     "customer_id": {
      "description": "Customer ID associated with the mandate",
      "type": "string"
     },
     "customer_identifier": {
      "description": "Identifier for the customer, such as a phone number",
      "type": "string"
     },
     "customer_name": {
      "description": "Name of the customer",
      "type": "string"
     },
     "customer_ref_number": {
      "description": "Reference number of the customer, not present in the provided JSON but assumed to be relevant",
      "type": "string"
     },
     "customer_vpa": {
      "description": "Virtual Payment Address of the customer",
      "type": "string"
     },
     "debit_account": {
      "description": "Debit account number",
      "type": "string"
     },
     "debit_ifsc": {
      "description": "IFSC code of the debit account",
      "type": "string"
     },
     "failure_message": {
      "description": "Message describing the reason for any failure",
      "type": "string"
     },
     "final_collection_date": {
      "description": "Date for the final collection attempt",
      "format": "date-time",
      "type": "string"
     },
     "first_collection_date": {
      "description": "Date for the first collection attempt",
      "format": "date-time",
      "type": "string"
     },
     "frequency": {
      "description": "Frequency of the mandate collection",
      "enum": [
       "ADHO",
       "INDA",
       "DAIL",
       "WEEK",
       "MNTH",
       "QURT",
       "MIAN",
       "YEAR",
       "ONETIME",
       "BIMN"
      ],
      "type": "string"
     },
     "id": {
      "description": "Unique identifier for the UPI mandate",
      "type": "string"
     },
     "is_recurring": {
      "default": false,
      "description": "Indicates if the mandate is for recurring payments",
      "type": "boolean"
     },
     "mandate_type": {
      "description": "Type of the mandate",
      "enum": [
       "CREATE",
       "AMEND",
       "CANCEL"
      ],
      "type": "string"
     },
     "maximum_amount": {
      "description": "Maximum amount that can be collected",
      "type": "number"
     },
     "merchant_code": {
      "description": "Merchant code",
      "type": "string"
     },
     "narration": {
      "description": "Narration for the mandate",
      "type": "string"
     },
     "org_psp_ref_no": {
      "description": "Reference number provided by the organization's PSP",
      "type": "string"
     },
     "partner_bank_code": {
      "description": "Bank code of the partner bank",
      "type": "string"
     },
     "scheme_ref_number": {
      "description": "Reference number of the scheme, not present in the provided JSON but assumed to be relevant",
      "type": "string"
     },
     "service_provider_name": {
      "description": "Name of the service provider",
      "type": "string"
     },
     "status": {
      "description": "Current status of the mandate",
      "enum": [
       "PARTIAL",
       "AUTH_FAILED",
       "AUTH_SUCCESS",
       "REGISTER_FAILED",
       "REGISTER_SUCCESS",
       "PAUSED",
       "CANCELLED",
       "EXPIRED",
       "REVOKED"
      ],
      "type": "string"
     },
     "umrn": {
      "description": "Unique Mandate Reference Number",
      "type": "string"
     },
     "updated_at": {
      "description": "Timestamp of the last update to the mandate",
      "format": "date-time",
      "type": "string"
     }
    },
    "type": "object"
   },
   "ExternalUpiScheduledPlanSchema_Client": {
    "properties": {
     "corporate": {
      "$ref": "#/components/schemas/CorporateDetailsSchema_Client"
     },
     "created_at": {
      "description": "Timestamp when the scheduled plan was created",
      "format": "date-time",
      "type": "string"
     },
     "customer": {
      "$ref": "#/components/schemas/CustomerDetailsSchema_Client"
     },
     "details": {
      "$ref": "#/components/schemas/UpiSchedulePlanDetails_Client"
     },
     "id": {
      "description": "Unique identifier for the UPI scheduled plan",
      "type": "string"
     },
     "last_transaction": {
      "$ref": "#/components/schemas/ExternalUpiDebitTxnSchema_Client"
     },
     "mandate": {
      "$ref": "#/components/schemas/ExternalUpiMandateSchema_Client"
     },
     "status": {
      "description": "Current status of the scheduled payment",
      "enum": [
       "ACTIVE",
       "CANCELLED",
       "PAUSED",
       "COMPLETED"
      ],
      "type": "string"
     },
     "sub_user": {
      "$ref": "#/components/schemas/ExternalSubUser_Client"
     },
     "transactions": {
      "description": "List of all transactions for the specific UPI schedule plan",
      "items": {
       "$ref": "#/components/schemas/ExternalUpiDebitTxnSchema_Client"
      },
      "type": "array"
     },
     "umrn": {
      "description": "Unique Mandate Reference Number for the scheduled plan",
      "type": "string"
     },
     "upcoming_transaction": {
      "$ref": "#/components/schemas/ExternalUpiDebitTxnSchema_Client"
     },
     "updated_at": {
      "description": "Timestamp when the scheduled plan was last updated",
      "format": "date-time",
      "type": "string"
     }
    },
    "type": "object"
   },
   "GenericBadRequestResponse_Client": {
    "properties": {
     "code": {
      "description": "Error code",
      "type": "string"
     },
     "details": {
      "description": "Details about the exception. Usually contains the exception id for reference.",
      "type": "string"
     },
     "errors": {
      "description": "Custom errors",
      "type": "string"
     },
     "message": {
      "description": "Description of the error",
      "type": "string"
     }
    },
    "type": "object"
   },
   "SplitSettlementInfo_Client": {
    "description": "Any one of corporate_account_number or settlement_config_profile_id or split_settlement_info is required.",
    "properties": {
     "settlement_account_number": {
      "description": "Bank Account Number",
      "type": "string"
     },
     "split_amount_in_paise": {
      "description": "Amount to be settled in paise",
      "format": "int32",
      "type": "integer"
     }
    },
    "required": [
     "split_amount_in_paise"
    ],
    "type": "object"
   },
   "TransactionDetails_Client": {
    "properties": {
     "account_number": {
      "description": "Account number associated with the transaction",
      "type": "string"
     },
     "amount_in_paise": {
      "description": "Amount in paise of the debit transaction",
      "format": "int64",
      "type": "integer"
     },
     "settlement_date": {
      "description": "Date and time when the settlement was processed",
      "format": "date-time",
      "type": "string"
     },
     "settlement_utr_number": {
      "description": "Unique Reference Number for the settlement",
      "type": "string"
     },
     "txn_id": {
      "description": "Transaction ID of the debit transaction",
      "type": "string"
     }
    },
    "type": "object"
   },
   "UpiMandateExtendedDetail_Client": {
