   "UpiSchedulePlanDetails_Client": {
    "properties": {
     "amount_in_paise": {
      "description": "Amount to be paid in paise",
      "format": "int32",
      "type": "integer"
     },
     "client_ref_id": {
      "description": "Client reference ID for identification",
      "type": "string"
     },
     "ended_at": {
      "description": "Date when the schedule ended",
      "format": "date-time",
      "type": "string"
     },
     "first_proposed_settlement_date": {
      "description": "Date for the first proposed settlement",
      "format": "date-time",
      "type": "string"
     },
     "frequency": {
      "description": "Frequency of subscription payments",
      "enum": [
       "onetime",
       "adhoc",
       "intraday",
       "daily",
       "weekly",
       "monthly",
       "quarterly",
       "semiannually",
       "yearly",
       "bimonthly"
      ],
      "type": "string"
     },
     "last_presented_at": {
      "description": "Date when the last payment was presented",
      "format": "date-time",
      "type": "string"
     },
     "last_presented_settlement_date": {
      "description": "Date of the last presented settlement",
      "format": "date-time",
      "type": "string"
     },
     "mandate_id": {
      "description": "Mandate ID associated with the payment schedule",
      "type": "string"
     },
     "narration": {
      "description": "Narration or description of the payment schedule",
      "type": "string"
     },
     "next_present_at": {
      "description": "Date when the next payment should be presented",
      "format": "date-time",
      "type": "string"
     },
     "next_scheduled_settlement_date": {
      "description": "Date for the next scheduled settlement",
      "format": "date-time",
      "type": "string"
     },
     "paid_count": {
      "default": 0,
      "description": "Number of payments already made",
      "format": "int32",
      "type": "integer"
     },
     "payment_count": {
      "description": "Total number of payments to be made",
      "format": "int32",
      "type": "integer"
     },
     "txn_reference": {
      "description": "Transaction reference",
      "type": "string"
     }
    },
    "type": "object"
   },
   "UpiScheduledPlanCreateRequest_Client": {
    "properties": {
     "amount": {
      "description": "Either  of amount or amount_in_paise is mandatory.",
      "type": "number"
     },
     "amount_in_paise": {
      "description": "Either  of amount or amount_in_paise is mandatory",
      "format": "int32",
      "type": "integer"
     },
     "corporate_account_number": {
      "description": "Any one of corporate_account_number or settlement_config_profile_id or split_settlement_info is required. All numeric",
      "maxLength": 18,
      "minLength": 8,
      "type": "string"
     },
     "frequency": {
      "default": "ONETIME",
      "enum": [
       "onetime",
       "adhoc",
       "intraday",
       "daily",
       "weekly",
       "monthly",
       "quarterly",
       "semiannually",
       "yearly",
       "bimonthly"
      ],
      "type": "string"
     },
     "narration": {
      "description": " Default: Enterprise name",
      "maxLength": 20,
      "minLength": 1,
      "type": "string"
     },
     "optional_attr": {
      "$ref": "#/components/schemas/UpiTxnOptionalAttr_Client"
     },
     "payment_count": {
      "default": 1,
      "description": "Should be non-negative and >= 1.  payment_count has to be one if frequency is ONETIME",
      "format": "int32",
      "type": "integer"
     },
     "settlement_config_profile_id": {
      "description": "Config of settlement, if already predefined. Any one of corporate_account_number or settlement_config_profile_id or split_settlement_info is required.",
      "type": "string"
     },
     "settlement_date": {
      "description": "Date for Settlement in yyyy-mm-dd hh:mm:ss\n\nDefault: \n(i) first_collection_date as provided in registered mandate\nOR\n(ii) current date\nNote : Settlement Date should be more than 26 hours from current time\n",
      "format": "date-time",
      "type": "string"
     },
     "split_settlement_info": {
      "description": "Any one of corporate_account_number or settlement_config_profile_id or split_settlement_info is required.",
      "items": {
       "$ref": "#/components/schemas/SplitSettlementInfo_Client"
      },
      "maxItems": 10,
      "minItems": 2,
      "type": "array"
     },
     "sub_user_identifier": {
      "description": "Set value to assign it to a sub-user",
      "type": "string"
     },
     "umrn": {
      "description": "Mandate UMRN created upon successful registration of Mandate",
      "type": "string"
     },
     "unique_key": {
      "description": "To be used for Corporate\u2019s reference.\nDefault: <umrn>_<count>\nex: <umrn>_1, <umrn>_2\nAllowed chars: a-zA-Z.0-9_\nNote : It should be unique for each created debit.\n",
      "maxLength": 30,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9-_]*$",
      "type": "string"
     },
     "upi_mandate_extended_detail": {
      "$ref": "#/components/schemas/UpiMandateExtendedDetail_Client"
     }
    },
    "required": [
     "frequency",
     "umrn"
    ],
    "type": "object"
   },
   "UpiTxnDetailsSchema_Client": {
    "description": "Detailed information about the UPI transaction",
    "properties": {
     "amount": {
      "description": "Transaction amount in standard currency units",
      "format": "double",
      "type": "number"
     },
     "amount_in_paise": {
      "description": "Transaction amount in the smallest currency units (e.g., paise)",
      "format": "int32",
      "type": "integer"
     },
     "customer_vpa": {
      "description": "Virtual Payment Address of the customer, if applicable",
      "type": "string"
     },
     "failure_code": {
      "description": "Code indicating the reason for transaction failure, if applicable",
      "type": "string"
     },
     "failure_reason": {
      "description": "Description of the reason for transaction failure, if applicable",
      "type": "string"
     },
     "ready_to_process_at": {
      "description": "Timestamp indicating when the transaction is ready to be processed",
      "format": "date-time",
      "type": "string"
     },
     "settlement_desc": {
      "description": "Description of the settlement",
      "type": "string"
     },
     "sponsor_bank_id": {
      "description": "Identifier for the sponsor bank",
      "type": "string"
     },
     "status": {
      "description": "Status of the NACH payment transaction",
      "enum": [
       "new",
       "ready_to_send",
       "skipped",
       "notify_initiated",
       "notified",
       "ready_to_debit",
       "debit_sequenced",
       "cancelled",
       "approved",
       "debit_initiated",
       "submitted_to_bank",
       "digio_technical_error",
       "accepted_spo_bank",
       "reject_spo_bank",
       "payment_delayed",
       "payment_authenticated",
       "payment_failed",
       "payment_success"
      ],
      "type": "string"
     },
     "txn_ref": {
      "description": "Reference number for the transaction",
      "type": "string"
     },
     "type": {
      "description": "Type of the transaction",
      "enum": [
       "nach_debit",
       "upi",
       "payment_link",
       "upi_debit"
      ],
      "type": "string"
