     },
     "authenticationTime": {
      "format": "date-time",
      "type": "string"
     },
     "corporateConfigId": {
      "type": "string"
     },
     "customerAccountNumber": {
      "type": "string"
     },
     "customerAccountType": {
      "enum": [
       "savings",
